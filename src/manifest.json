{
  "name": "PPM Assistant",
  "description": "Extends PPM with usefull comparisons, skill calculations etc",
  "version": "3.0",
  "manifest_version": 3,
  "icons": {
    "128": "icon_128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/star-diamond.svg",
        "icons/star-gold.svg",
        "icons/star-silver.svg",
        "icons/star-empty.svg",
        "test.html",
        "player-report.html"
      ],
      "matches": [
        "https://hockey.powerplaymanager.com/*",
        "https://soccer.powerplaymanager.com/*",
        "https://basketball.powerplaymanager.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hockey.powerplaymanager.com/*"
      ],
      "include_globs": [
        "*speletaju-ligumi*",
        "*player-contracts*"
      ],
      "css": [
        "hide-table.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://hockey.powerplaymanager.com/*",
        "https://soccer.powerplaymanager.com/*",
        "https://basketball.powerplaymanager.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}